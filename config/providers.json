{
  "schema_version": 1,
  "providers": [
    {
      "id": "minimax",
      "kind": "minimax_openai_compatible",
      "enabled": true,
      "auth_mode": "api_key",
      "api_usage_allowed": true,
      "api_key_env": "MINIMAX_API_KEY",
      "base_url_env": "MINIMAX_BASE_URL",
      "model_env": "MINIMAX_MODEL",
      "endpoint_path": "/chat/completions",
      "allowed_hosts": ["api.minimax.io"],
      "capabilities": ["text_generation"],
      "approved_privacy": [
        "public",
        "internal_approved",
        "local_or_approved_cloud"
      ],
      "notes": "First required API provider. Live calls remain blocked until all named environment variables exist."
    },
    {
      "id": "grok",
      "kind": "grok_responses_pending",
      "enabled": false,
      "auth_mode": "pending",
      "api_usage_allowed": true,
      "api_key_env": "XAI_API_KEY",
      "capabilities": ["text_generation"],
      "approved_privacy": ["public", "internal_approved"],
      "disabled_reason": "API access has not been applied for yet.",
      "notes": "Reserved for a later Responses API conformance test."
    },
    {
      "id": "claude_subscription",
      "kind": "external_subscription_client",
      "enabled": false,
      "auth_mode": "subscription_client",
      "api_usage_allowed": false,
      "capabilities": ["text_generation"],
      "approved_privacy": [],
      "disabled_reason": "No approved subscription-client adapter has been selected or verified.",
      "notes": "Anthropic API fallback is forbidden by operator policy."
    }
  ]
}
